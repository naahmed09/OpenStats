{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStats",
  "mainBinaryName": "OpenStats",
  "version": "1.0.0",
  "identifier": "org.openstats.desktop",
  "build": {
    "frontendDist": "../../../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenStats",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "license": "Apache-2.0 OR MIT",
    "category": "Education",
    "shortDescription": "Open-source statistical analysis",
    "fileAssociations": [
      {
        "ext": [
          "otb"
        ],
        "name": "OpenStats project",
        "mimeType": "application/x-openstats-project",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "The OpenStats Contributors",
    "copyright": "Copyright (c) The OpenStats Contributors. Apache-2.0 OR MIT.",
    "longDescription": "OpenStats is an open-source statistical analysis workbench: worksheet, Session window, graphs, quality tools, regression, ANOVA and design of experiments.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
